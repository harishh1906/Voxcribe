# ==========================================
# Voxcribe Configuration (.env)
# ==========================================

# Database Configuration
# Local Docker Compose uses Postgres:
DATABASE_URL=postgresql://postgres:postgres@db:5432/voxcribe

# Whisper Model Configuration
# Dedicated Hinglish CTranslate2 model (~78 MB INT8):
WHISPER_MODEL=MSpider3/whisper-hindi2hinglish-swift-ct2
WHISPER_LANGUAGE=en

# Device & Acceleration
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=2

# Audio Processing
VAD_THRESHOLD=0.5
AUDIO_CHUNK_DURATION=3.0
AUDIO_OVERLAP_DURATION=0.5
AUDIO_SAMPLE_RATE=16000

# App Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
LOG_LEVEL=INFO
