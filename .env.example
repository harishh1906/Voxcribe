# ==========================================
# Voxcribe Configuration (.env)
# ==========================================

# Database Configuration
# Local Docker Compose uses Postgres:
DATABASE_URL=postgresql://postgres:postgres@db:5432/voxcribe
# For Cloud Deployments:
# - Use free managed Postgres (e.g. Neon.tech, Supabase):
#   DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/voxcribe?sslmode=require
# - Or use SQLite for lightweight single-container cloud hosting:
#   DATABASE_URL=sqlite:///./voxcribe.db

# Whisper Model Configuration
# Available models: tiny, base, small, medium, large-v3
# Recommended:
# - CPU / Free Cloud Tier: 'small' (balanced) or 'base' (faster)
# - GPU: 'small' or 'medium'
WHISPER_MODEL=small

# Device & Acceleration
# Options: 'cpu' or 'cuda' (for NVIDIA GPU)
WHISPER_DEVICE=cpu

# Quantization
# 'int8' for CPU (efficient), 'float16' for CUDA GPU
WHISPER_COMPUTE_TYPE=int8

# Beam Size (1 = greedy/fastest, 3 = balanced, 5 = highest accuracy)
WHISPER_BEAM_SIZE=3

# CPU Threads (set to match physical CPU cores; typically 2 for free cloud tiers, 4 for laptops)
WHISPER_CPU_THREADS=4

# Audio Processing
VAD_THRESHOLD=0.5
AUDIO_CHUNK_DURATION=3.0
AUDIO_OVERLAP_DURATION=0.5
AUDIO_SAMPLE_RATE=16000

# App Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
LOG_LEVEL=INFO
